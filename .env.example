# Use "openai" for OpenAI-compatible providers, "anthropic" for Anthropic, or
# "claude-cli" for the local Claude Code CLI (uses its login; no API key needed).
LLM_PROVIDER=openai
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=60
# Only used by claude-cli: path or name of the Claude Code executable.
LLM_CLI_PATH=claude
